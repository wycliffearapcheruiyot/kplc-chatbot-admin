# The gateway's public Render URL. Safe in the build (it is a public URL).
# NEVER add the admin token here: VITE_ values are copied into the public JS.
# The token is typed into the login box instead.
VITE_API_URL="https://kplc-chatbot-gateway.onrender.com"

# The other two Render services. The admin never calls their real endpoints;
# it only pings their public GET /health so all three wake in parallel on load.
# Leave either blank to skip warming it.
VITE_SESSION_BACKEND_URL="https://kplc-kaggle-notebook-instance.onrender.com"
VITE_DATASET_BACKEND_URL="https://dataset-trigger-backend.onrender.com"
